	opp-table {
		compatible = "operating-points-v2";
		phandle = <0x9f>;

		opp-180000000 {
			opp-hz = <0x00 0xaba9500>;
			required-opps = <0x23>;
		};

		opp-275000000 {
			opp-hz = <0x00 0x10642ac0>;
			required-opps = <0x24>;
		};

		opp-358000000 {
			opp-hz = <0x00 0x1556a580>;
			required-opps = <0x25>;
		};
	};

	opp-table-qup {
		compatible = "operating-points-v2";
		phandle = <0x3a>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x23>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x24>;
		};

		opp-128000000 {
			opp-hz = <0x00 0x7a12000>;
			required-opps = <0x26>;
		};
