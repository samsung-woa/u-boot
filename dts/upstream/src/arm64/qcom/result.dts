/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Samsung Galaxy A71";
	compatible = "samsung,a715f\0qcom,sm7150";
	chassis-type = "handset";
	qcom,msm-id = <0x16d 0x00>;
	qcom,board-id = <0x22 0x00 0x22 0x01 0x22 0x02 0x22 0x03 0x22 0x04 0x22 0x05 0x22 0x06 0x22 0x07>;

	aliases {
		mmc1 = "/soc@0/mmc@7c4000";
		mmc2 = "/soc@0/mmc@8804000";
		i2c0 = "/soc@0/geniqup@8c0000/i2c@880000";
		i2c1 = "/soc@0/geniqup@8c0000/i2c@884000";
		i2c2 = "/soc@0/geniqup@8c0000/i2c@888000";
		i2c3 = "/soc@0/geniqup@8c0000/i2c@88c000";
		i2c4 = "/soc@0/geniqup@8c0000/i2c@890000";
		i2c6 = "/soc@0/geniqup@ac0000/i2c@a80000";
		i2c7 = "/soc@0/geniqup@ac0000/i2c@a84000";
		i2c8 = "/soc@0/geniqup@ac0000/i2c@a88000";
		i2c9 = "/soc@0/geniqup@ac0000/i2c@a8c000";
		i2c10 = "/soc@0/geniqup@ac0000/i2c@a90000";
		i2c11 = "/soc@0/geniqup@ac0000/i2c@a94000";
		spi0 = "/soc@0/geniqup@8c0000/spi@880000";
		spi1 = "/soc@0/geniqup@8c0000/spi@884000";
		spi3 = "/soc@0/geniqup@8c0000/spi@88c000";
		spi4 = "/soc@0/geniqup@8c0000/spi@890000";
		spi6 = "/soc@0/geniqup@ac0000/spi@a80000";
		spi7 = "/soc@0/geniqup@ac0000/spi@a84000";
		spi8 = "/soc@0/geniqup@ac0000/spi@a88000";
		spi10 = "/soc@0/geniqup@ac0000/spi@a90000";
		spi11 = "/soc@0/geniqup@ac0000/spi@a94000";
		bluetooth0 = "/soc@0/geniqup@8c0000/serial@88c000/bluetooth";
		hsuart0 = "/soc@0/geniqup@8c0000/serial@88c000";
		wifi0 = "/soc@0/wifi@18800000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@9c000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0x9c000000 0x00 0x9e3400>;
			width = <0x438>;
			height = <0x960>;
			stride = <0x10e0>;
			format = "a8r8g8b8";
			clocks = <0x02 0x18>;
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x249f000>;
			#clock-cells = <0x00>;
			phandle = <0xb2>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7d00>;
			#clock-cells = <0x00>;
			phandle = <0x33>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x00>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x08>;
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0x89>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x08>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x0a>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x100>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0c>;
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0x89>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x0c>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x200>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x0d>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0e>;
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0x89>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x0e>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x300>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x10>;
