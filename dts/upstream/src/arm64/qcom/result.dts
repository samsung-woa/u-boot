			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x10>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x400>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x11>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x12>;
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0x89>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x12>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x500>;
			clocks = <0x03 0x00>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x13>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x14>;
			capacity-dmips-mhz = <0x1e8>;
			dynamic-power-coefficient = <0x89>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x09>;
			#cooling-cells = <0x02>;
			phandle = <0x1f>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x14>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x600>;
			clocks = <0x03 0x01>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x15>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x16>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1e0>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x17>;
			#cooling-cells = <0x02>;
			phandle = <0x20>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x16>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo470";
			reg = <0x00 0x700>;
			clocks = <0x03 0x01>;
			interconnects = <0x04 0x00 0x03 0x05 0x01 0x03 0x06 0x00 0x06 0x01>;
			power-domains = <0x18>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x19>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1e0>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x17>;
			#cooling-cells = <0x02>;
			phandle = <0x21>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x19>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1a>;
				};

				core1 {
					cpu = <0x1b>;
				};

				core2 {
					cpu = <0x1c>;
				};

				core3 {
					cpu = <0x1d>;
				};

				core4 {
					cpu = <0x1e>;
				};

				core5 {
					cpu = <0x1f>;
				};

				core6 {
					cpu = <0x20>;
				};

				core7 {
					cpu = <0x21>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x225>;
				exit-latency-us = <0x385>;
				min-residency-us = <0x6ee>;
				local-timer-stop;
				phandle = <0x28>;
			};

			cpu-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "little-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x2be>;
				exit-latency-us = <0x393>;
				min-residency-us = <0xfa1>;
				local-timer-stop;
				phandle = <0x29>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "big-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x20b>;
				exit-latency-us = <0x4dc>;
				min-residency-us = <0x89f>;
				local-timer-stop;
				phandle = <0x2a>;
			};

			cpu-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "big-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x20e>;
				exit-latency-us = <0x73e>;
				min-residency-us = <0x15b3>;
				local-timer-stop;
				phandle = <0x2b>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0xac0>;
				exit-latency-us = <0xbe8>;
				min-residency-us = <0x17e6>;
				phandle = <0x2c>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41001244>;
				entry-latency-us = <0xe36>;
				exit-latency-us = <0x11d2>;
				min-residency-us = <0x2113>;
				phandle = <0x2d>;
			};

			cluster-sleep-2 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100b244>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2662>;
				phandle = <0x2e>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm7150\0qcom,scm";
			interconnects = <0x22 0x04 0x07 0x05 0x01 0x07>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	opp-table-cpu0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x09>;

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			opp-peak-kBps = <0x30d400 0x927c00>;
		};

		opp-576000000 {
			opp-hz = <0x00 0x22551000>;
			opp-peak-kBps = <0x30d400 0x10fe000>;
		};

		opp-768000000 {
			opp-hz = <0x00 0x2dc6c000>;
