	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		charge-full-design-microamp-hours = <0x44aa20>;
		phandle = <0xb0>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xd4>;

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xa2 0x02 0x01>;
			debounce-interval = <0x0f>;
		};
	};
