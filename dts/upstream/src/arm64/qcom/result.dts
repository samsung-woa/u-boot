		interconnect@18321000 {
			compatible = "qcom,sm7150-osm-l3\0qcom,osm-l3";
			reg = <0x00 0x18321000 0x00 0x1400>;
			clocks = <0x32 0x00 0x02 0x01>;
			clock-names = "xo\0alternate";
			#interconnect-cells = <0x01>;
			phandle = <0x06>;
		};

		cpufreq@18323000 {
			compatible = "qcom,sm7150-cpufreq-hw\0qcom,cpufreq-hw";
			reg = <0x00 0x18323000 0x00 0x1400 0x00 0x18325800 0x00 0x1400>;
			reg-names = "freq-domain0\0freq-domain1";
			clocks = <0x32 0x00 0x02 0x01>;
			clock-names = "xo\0alternate";
			#freq-domain-cells = <0x01>;
			#clock-cells = <0x01>;
			phandle = <0x03>;
		};

		wifi@18800000 {
			compatible = "qcom,wcn3990-wifi";
			reg = <0x00 0x18800000 0x00 0x800000>;
			reg-names = "membase";
			interrupts = <0x00 0x19e 0x04 0x00 0x19f 0x04 0x00 0x1a0 0x04 0x00 0x1a1 0x04 0x00 0x1a2 0x04 0x00 0x1a3 0x04 0x00 0x1a4 0x04 0x00 0x1a5 0x04 0x00 0x1a6 0x04 0x00 0x1a7 0x04 0x00 0x1a8 0x04 0x00 0x1a9 0x04>;
			iommus = <0x34 0x240 0x01>;
			memory-region = <0xb4>;
			status = "disabled";
			vdd-0.8-cx-mx-supply = <0xb5>;
			vdd-1.8-xo-supply = <0x48>;
			vdd-1.3-rfa-supply = <0x49>;
			vdd-3.3-ch0-supply = <0x4a>;
			vdd-3.3-ch1-supply = <0xb6>;
		};

		pinctrl@62b52000 {
			compatible = "qcom,sm7150-lpass-lpi-pinctrl";
			reg = <0x00 0x62b52000 0x00 0xe000>;
			clocks = <0xb7 0x66 0x01>;
			clock-names = "core";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0xb8 0x00 0x00 0x0e>;
			phandle = <0xb8>;

			tx-swr-active-state {

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data1-pins {
					pins = "gpio1";
					function = "swr_tx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data2-pins {
					pins = "gpio2";
					function = "swr_tx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};
			};

			tx-swr-sleep-state {

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data1-pins {
					pins = "gpio1";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data2-pins {
					pins = "gpio2";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};
			};

			rx-swr-active-state {

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x08>;
					bias-bus-hold;
				};

				data-pins {
					pins = "gpio4\0gpio5";
					function = "swr_rx_data";
					drive-strength = <0x08>;
					bias-bus-hold;
				};
			};

			rx-swr-sleep-state {

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x02>;
					bias-bus-hold;
				};

				data-pins {
					pins = "gpio4\0gpio5";
					function = "swr_rx_data";
					drive-strength = <0x02>;
					bias-bus-hold;
				};
			};

			wcd9375-reset-active-state {
				pins = "gpio6";
				function = "cdc_pdm_rx";
				drive-strength = <0x10>;
				output-high;
			};

			wcd9375-reset-sleep-state {
				pins = "gpio6";
				function = "cdc_pdm_rx";
				drive-strength = <0x10>;
				bias-disable;
				output-low;
			};

			dmic01-active-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic1_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			dmic01-sleep-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic1_clk";
					drive-strength = <0x02>;
					bias-disable;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic1_data";
					drive-strength = <0x02>;
					pull-down;
					input-enable;
				};
			};

			dmic23-active-state {

				clk-pins {
					pins = "gpio10";
					function = "dmic2_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio11";
					function = "dmic2_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			dmic23-sleep-state {

				clk-pins {
					pins = "gpio10";
					function = "dmic2_clk";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};

				data-pins {
					pins = "gpio11";
					function = "dmic2_data";
					drive-strength = <0x02>;
					pull-down;
					input-enable;
				};
			};
		};
	};

