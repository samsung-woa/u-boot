	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	pmu-a76 {
		compatible = "arm,cortex-a78-pmu";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x07>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x0b>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x0d>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x0f>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x11>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x28 0x29>;
			phandle = <0x13>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x2a 0x2b>;
			phandle = <0x15>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x27>;
			domain-idle-states = <0x2a 0x2b>;
			phandle = <0x18>;
		};

		power-domain-cluster {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x2c 0x2d 0x2e>;
			phandle = <0x27>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		hypervisor@85700000 {
			reg = <0x00 0x85700000 0x00 0x600000>;
			no-map;
		};

		xbl@85d00000 {
			reg = <0x00 0x85d00000 0x00 0x200000>;
			no-map;
		};

		aop@85f00000 {
			reg = <0x00 0x85f00000 0x00 0x20000>;
			no-map;
		};

